  },
  "night": {
   "file": "night.mp3",
   "gain": 0.78,
   "note": "Outdoors after dark. Crickets, cool still air, one far-off dog."
  },
  "river": {
   "file": "river.mp3",
   "gain": 0.85,
   "note": "Moving fresh water close by, reeds on the bank."
  },
  "road": {
   "file": "road.mp3",
   "gain": 0.82,
   "note": "Travel on foot outdoors. Grit underfoot, wide dry air."
  },
  "storm": {
   "file": "storm.mp3",
   "gain": 0.85,
   "note": "Rain on hard ground with distant thunder. The sky closing over."
  },
  "temple": {
   "file": "temple.mp3",
   "gain": 0.85,
   "note": "An enormous sacred stone interior. Vast slow air, a brazier hiss, a deep held tone."
  },
  "void": {
   "file": "void.mp3",
