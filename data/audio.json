{
 "version": 1,
 "note": "Bed map for read.html. Resolution, most specific first: stacks[stack].cards[card] -> stacks[stack].beats[beat] -> stacks[stack].bed -> topics[topic].beats[beat] -> topics[topic].bed -> default. `card` is the 0-based data-card index read.html writes, not the 1-based n in stacks.json. An unresolved card or beat HOLDS whatever is already playing; it never cuts to silence. The per-card rows are merged in from data/cardaudio.json, which keeps the per-card reasoning and stays out of the browser's way. See AUDIO-READER.md and AUDIO-CARDS.md.",
 "base": "audio/",
 "default": "scroll",
 "beds": {
  "palace": {
   "file": "palace.mp3",
   "gain": 0.85,
   "note": "A fountain in a courtyard, cicadas beyond it. Mediterranean, hot, outdoors-but-enclosed."
  },
  "harbour": {
   "file": "harbour.mp3",
   "gain": 1.0,
   "note": "Sea and gulls at dusk. Alexandria."
  },
  "harbour-arrival": {
   "file": "harbour-arrival.mp3",
   "gain": 0.86,
   "note": "Water on hulls, mass, a crowd a quarter-mile off."
  },
  "sea": {
   "file": "sea.mp3",
   "gain": 1.0,
   "note": "Open sea."
  },
  "triumph": {
   "file": "triumph.mp3",
   "gain": 0.95,
   "note": "A crowd in the street. The busiest bed in the set and the one a phone speaker reproduces best."
  },
  "bath": {
   "file": "bath.mp3",
   "gain": 0.8,
   "note": "Poured water in a hard, reverberant room."
  },
  "letter": {
   "file": "letter.mp3",
   "gain": 0.8,
   "note": "A still room, a writing hand, a tread somewhere beyond the door."
  },
  "copies": {
   "file": "copies.mp3",
   "gain": 0.85,
   "note": "A scriptorium. Dry, papery, patient. The sound of a document being examined."
  },
  "scroll": {
   "file": "scroll.mp3",
   "gain": 0.85,
   "note": "A still small interior. The neutral fallback: it is nowhere in particular, which is the point."
  },
  "basket": {
   "file": "basket.mp3",
   "gain": 0.85,
   "note": "Close, dry, small. A rustle in a container."
  },
  "vials": {
   "file": "vials.mp3",
   "gain": 0.75,
   "note": "A physician's table. Small glass, a pestle, careful handling."
  },
  "gallery": {
   "file": "gallery.mp3",
   "gain": 0.8,
   "note": "A big cool room with a long tail. A museum hall; the room where the paintings are."
  },
  "vault": {
   "file": "vault.mp3",
   "gain": 0.85,
   "note": "A large dark stone interior with a long tail. Council chamber, cathedral, trial hall, cellar. Synthesised - see build-reader-beds.py."
  },
  "wind": {
   "file": "wind.mp3",
   "gain": 0.85,
   "note": "Open, dry, outdoors, no water. Desert, steppe, hillside. Synthesised - see build-reader-beds.py."
  },
  "reactor": {
   "file": "reactor.mp3",
   "gain": 0.85,
   "note": "A machine room. Cold, continuous, mechanical, no century. Synthesised - see build-reader-beds.py."
  },
  "door": {
   "file": "door.mp3",
   "gain": 0.95,
   "note": "ACCENT. A shut door in near-dark. Almost nothing above 500 Hz, so on a phone this reads as the room going quiet."
  },
  "coil": {
   "file": "coil.mp3",
   "gain": 0.95,
   "note": "ACCENT. A low drone under a question. Almost nothing above 500 Hz."
  },
  "search": {
   "file": "search.mp3",
   "gain": 0.72,
   "note": "ACCENT. The room after it was searched. The deliberate near-silence of the set."
  },
  "battle": {
   "file": "battle.mp3",
   "gain": 0.85,
   "note": "An army at middle distance. Mass, metal, low ground rumble. No voices."
  },
  "court": {
   "file": "court.mp3",
   "gain": 0.82,
   "note": "An indoor throne room. Hard marble, a low human murmur that never resolves into words."
  },
  "crypt": {
   "file": "crypt.mp3",
   "gain": 0.78,
   "note": "Small, dead, underground. No outside at all, a slow drip, a floor rumble. Tomb, cave, cell."
  },
  "dig": {
   "file": "dig.mp3",
   "gain": 0.8,
   "note": "An excavation outdoors. Loose grit and soil, thin wind, sparse tool contact."
  },
  "field": {
   "file": "field.mp3",
   "gain": 0.8,
   "note": "Open warm countryside. Grass, insects, a bird or two. Galilee, Kentucky, a garden."
  },
  "fire": {
   "file": "fire.mp3",
   "gain": 0.88,
   "note": "A large fire close by. Broad roar with irregular crackle over it."
  },
  "hall": {
   "file": "hall.mp3",
   "gain": 0.82,
