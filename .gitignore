# Function deps — installed by npm, not committed.
functions/node_modules/
node_modules/
tools/node_modules/

# Bed build intermediates. Regenerated by tools/build-beds.py; 15MB of WAV
# has no business in a repo that ships mp3.
_reader-bed-tmp/

# Build products. compose.py writes the artifact preview here; nothing in
# this directory is ever deployed.
build/

# Python bytecode.
__pycache__/
*.pyc

# The corpus, and the reason it is not under data/.
#
# data/stacks.json used to ship every word of all 51 stories to anyone who
# typed the URL — the whole product, free, no account. GitHub Pages publishes
# every tracked file, so there is no directory in this repo where a paid card
# body can sit safely. Paid text now lives in Firestore and leaves the
# building only through functions/story.js, which checks the reader first.
#
# This file stays as the BUILD INPUT: tools/seed-firebase.js reads it to fill
# Firestore, and split-stacks.js reads it to write data/index.json and the two
# permanently-free story files. It is regenerated by tools/build_stacks.py
# from the content package. Never track it.
content/
tools/shots/
tools/reel/.venv/
tools/reel/runs/

# tools/collect — the collectors' working files. None of this is source.
#
# discovered/ holds dumps and SCREENSHOTS of the owner's own signed-in
# Instagram dashboard; unmatched/ holds posts that had no row yet; state/
# holds the ledger, which is the local copy of numbers TikTok will stop
# serving after seven days. ig-labels.json is written from a real dashboard
# on a real machine and is not the same on anyone else's.
tools/collect/discovered/
tools/collect/unmatched/
tools/collect/state/
tools/collect/ig-labels.json
