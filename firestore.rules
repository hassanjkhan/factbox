rules_version = '2';

// ==========================================================================
// Factbox — Firestore security rules.
//
// The site is static and its JavaScript is public, so these rules are not a
// second opinion on what the client asks for; they are the only thing standing
// between a reader and everyone else's data. Written closed: the last rule
// denies everything not explicitly allowed above it.
//
// Collection names match the Stripe extension's defaults on purpose. Renaming
// them means renaming them here, in the extension config, and in the client.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- The two of us -----------------------------------------------------
    // An admin is a `customers/{uid}` document carrying `admin == true` OR
    // `role == "admin"`. Both flags, because that is what js/auth.js accepts
    // (adminFlag, in the customer snapshot it already has open) and what
    // functions/insights.js filters on in adminUids() — a rule that honoured
    // only one of them would let somebody through the analytics door and not
    // the task board, or the other way round, and nobody would find out until
    // Kathryn's writes started failing.
    //
    // This is a document READ per request, which is why it is used on two
    // collections and not on the reader's hot path. `customers/{uid}` is
    // written by the Stripe webhook and by the console, and by no browser at
    // all (`allow write: if false` above), so the flag cannot be granted from
    // the client side: a client that could set `admin: true` on itself would
    // own everything below.
    //
    // exists() first: get() on a document that is not there returns null and
    // reading .data off null is an evaluation error, which denies — the same
    // answer, but by accident rather than on purpose.
    function adminData() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(request.auth.uid))
        && (adminData().get("admin", false) == true
            || adminData().get("role", "") == "admin");
    }

    // --- Shape helpers for the one client-written document ---------------
    // Each is "absent, or the right type and small enough". Absent is legal
    // because a question the reader skipped must produce no field at all.
    function shortStr(k, n) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is string && request.resource.data[k].size() <= n);
    }
    // "absent, or the empty string, or exactly one calendar day". The board's
    // `due` field: the day a task is WANTED by, as "YYYY-MM-DD".
    //
    // A STRING AND NOT A TIMESTAMP, and this is the half of that decision the
    // rules get a vote on: a timestamp field can be checked for its TYPE and
    // nothing else — there is no expression here that can say "and it must be
    // local midnight". A string can be pinned exactly, and is, so a console
    // cannot put "next tuesday", "2026-13-01" or a megabyte in this field.
    //
    // The regex refuses month 00 and 13, and day 00 and 32. It still accepts
    // 2026-02-31, which is a real limitation: RE2 cannot count the days in a
    // month. js/admin-tasks.js rejects that one by round-tripping the date
    // through UTC before it writes, and a 31 February that somehow landed here
    // would render as "no date" rather than as anything wrong — the board
    // parses this field with the same round trip it validates with.
    //
    // The empty string is how "cleared" is spelled, so that clearing a date is
    // an ordinary field write and not a deleteField(). Absent is legal too:
    // the 130-odd rows seeded from git predate this field entirely, and an
    // edit to one of them must not have to invent one.
    function dayStr(k) {
      return !(k in request.resource.data)
        || request.resource.data[k] == ""
        || (request.resource.data[k] is string
            && request.resource.data[k].size() == 10
            && request.resource.data[k].matches("^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"));
    }
    // "absent, or null, or a string that fits". The board clears an
    // authorship field by writing null rather than by deleting the key —
    // deleteField() would need another import on a page that is deliberately
    // one dynamic import deep — so null has to be a legal value here.
    function nullStr(k, n) {
      return !(k in request.resource.data)
        || request.resource.data[k] == null
        || (request.resource.data[k] is string && request.resource.data[k].size() <= n);
    }
    function smallList(k, n) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is list && request.resource.data[k].size() <= n);
    }
    function smallInt(k, n) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is int
            && request.resource.data[k] >= 0
            && request.resource.data[k] <= n);
    }
    // "absent, or null, or a number in range". THE EXPERIMENT BOARD'S METRIC
    // FIELDS, and null is the whole point of it: a reel nobody typed a `saves`
    // figure for has NO saves figure, and 0 is a different claim — it says
    // somebody looked and there were none. A rule that accepted only numbers
    // would push the client into writing zeros for every box left empty, which
    // is how a board full of half-typed rows becomes a board full of charts
    // with fabricated points on them. Both bounds are checked because a
    // percentage above 100 and a negative count are typos, and a typo stored
    // is a typo charted.
    function numOrNull(k, lo, hi) {
      return !(k in request.resource.data)
        || request.resource.data[k] == null
        || (request.resource.data[k] is number
            && request.resource.data[k] >= lo
            && request.resource.data[k] <= hi);
    }
    // "absent, or null, or a timestamp". `postedAt` and `measuredAt` are the
    // two instants the 72-hour rule is computed from, and NEITHER may be
    // pinned to request.time the way `updatedAt` is: both are facts about the
    // past that a person types in, and the server clock knows nothing about
    // when a reel went up. What the rules can say is that they are timestamps
    // and not strings, which is enough to keep "3 days ago" out of a field the
    // page does arithmetic on.
    function tsOrNull(k) {
      return !(k in request.resource.data)
        || request.resource.data[k] == null
        || request.resource.data[k] is timestamp;
    }
    // "absent, or the empty string, or an https:// URL that fits".
    //
    // A URL A USER PASTED IS AN EXECUTION SURFACE once the page puts it in an
    // href, and the scheme is the whole of the defence: `javascript:` and
    // `data:` are not locations. So the scheme is pinned HERE as well as in
    // js/admin-experiments.js, because the client-side check is a convenience
    // for whoever is typing and this is the boundary. The empty string is how
    // "no link" is spelled, the same way `due` spells "no date".
    //
    // WHAT THIS REGEX CANNOT DO, said plainly rather than implied: RE2 has no
    // opinion about what is on the other end, so this refuses a scheme and a
    // newline and accepts every https:// string otherwise. Control characters
    // inside the URL — which browsers strip before resolving, and which are
    // therefore a way to hide a scheme — are removed by safeUrl() in the
    // client and by nothing else. `.` does not match a newline in RE2, so a
    // multi-line value is refused here, which is the one part of that family
    // these rules can actually take.
    function httpsStr(k, n) {
      return !(k in request.resource.data)
        || request.resource.data[k] == ""
        || (request.resource.data[k] is string
            && request.resource.data[k].size() <= n
            && request.resource.data[k].matches("^https://.+$"));
    }
    // "present, a string, not empty, and small enough" — the opposite of
    // shortStr, for the fields a row cannot exist without.
    function reqStr(k, n) {
      return k in request.resource.data
        && request.resource.data[k] is string
        && request.resource.data[k].size() > 0
        && request.resource.data[k].size() <= n;
    }

    // --- The reader's own record -----------------------------------------
    // Written by the Stripe extension from a webhook, never by the browser.
    // A reader may look at their own row and nothing else; nobody may write,
    // because a client that could write here could grant itself a
    // subscription.
    match /customers/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      // --- The reader's own onboarding answers -------------------------
      // js/profile-sync.js mirrors js/account.js's record here so it
      // survives losing the browser. This is the ONLY document on the site
      // a reader writes to about themselves, and it is deliberately a
      // subdocument: `customers/{uid}` itself belongs to the Stripe webhook,
      // and a client write racing that would clobber a subscription state
      // nothing here can rebuild.
      //
      // Nothing decides access from this. `premium` is still the one flag.
      // The worst a reader can do with a forged write is lie to us about
      // how many minutes a day they meant to read.
      //
      // The key list is closed, so a future field has to be added here on
      // purpose. Sizes are capped because this document is client-written
      // and an uncapped string is a free hosting bill.
      match /profile/{docId} {
        allow read: if isSelf(uid);
        allow delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && docId == "onboarding"
          && request.resource.data.keys().hasOnly([
               "schema", "updatedAt", "draw", "relates", "goalMinutes",
               "streakDays", "planAnswers", "interests", "frequency",
               "plan", "name", "email", "localAccountId", "onboardingComplete"
             ])
          && request.resource.data.schema is int
          && (!("updatedAt" in request.resource.data)
              || request.resource.data.updatedAt == request.time)
          && shortStr("draw", 30)
          && shortStr("frequency", 20)
          && shortStr("plan", 20)
          && shortStr("name", 40)
          && shortStr("email", 120)
          && shortStr("localAccountId", 40)
          && smallList("relates", 8)
          && smallList("planAnswers", 3)
          && smallList("interests", 12)
          && smallInt("goalMinutes", 1440)
          && smallInt("streakDays", 3650)
          && (!("onboardingComplete" in request.resource.data)
              || request.resource.data.onboardingComplete is bool);

        // --- The reader's own reading progress and saves ----------------
        // js/progress-sync.js mirrors js/progress.js's reading map and
        // js/saves.js's bookmark list here. Same subcollection and same
        // reasoning as `onboarding` above: `customers/{uid}` belongs to the
        // Stripe webhook and a client write racing it would clobber a
        // subscription state nothing here can rebuild.
        //
        // Nothing decides access from this either. The worst a reader can do
        // with a forged write is lie to us about which of their own stories
        // they finished.
        //
        // WHY BOTH PAYLOADS ARE STRINGS. The obvious shape is a map of story
        // id -> [card, total, seconds, done]. A rule cannot check it. Story
        // ids are data, so `keys().hasOnly([...])` cannot enumerate them, and
        // there is no way to reach inside a map and cap the value under a key
        // whose name is not known here. `m is map && m.size() <= 60` would
        // therefore permit sixty keys each holding a 16KB string — very
        // nearly the 1MiB document limit, written by anyone with an account.
        //
        // A string has exactly one length, and the two caps below are the
        // same numbers js/progress.js (MAX_BYTES 20000) and js/saves.js
        // (MAX_BYTES 8000) already enforce on themselves, so a well-behaved
        // client never comes close and a hostile one is stopped here. Nothing
        // queries these fields, so the opacity costs nothing.
        //
        // updatedAt is written `optional, or request.time`, exactly as
        // `onboarding` above is. Note what that means once the document
        // exists: a merge write that omits the field leaves the stored value
        // in place, so `updatedAt` is still in request.resource.data and is
        // still the OLD timestamp, which is not request.time — and the write
        // is refused. Measured, from a browser: the same payload is denied
        // without serverTimestamp() and accepted with it. That is the
        // behaviour we want and js/progress-sync.js always sends the sentinel;
        // the effect is that every timestamp in here came off a server clock
        // and none of them came off a reader's.
        //
        // The counts are advisory — for a human reading the console — and are
        // capped at each file's MAX_ENTRIES so they cannot become a hiding
        // place for a large number either. Nothing trusts them.
        allow create, update: if isSelf(uid)
          && docId == "reading"
          && request.resource.data.keys().hasOnly([
               "schema", "updatedAt", "count", "map", "saveCount", "saves"
             ])
          && request.resource.data.schema is int
          && request.resource.data.schema == 1
          && (!("updatedAt" in request.resource.data)
              || request.resource.data.updatedAt == request.time)
          && smallInt("count", 60)
          && smallInt("saveCount", 200)
          && request.resource.data.map is string
          && request.resource.data.map.size() <= 20000
          && (!("saves" in request.resource.data)
              || (request.resource.data.saves is string
                  && request.resource.data.saves.size() <= 8000));
      }

      match /checkout_sessions/{id} {
        // The one place the client legitimately writes: asking the extension
        // to start a checkout. It may read back the session it created.
        allow read, create: if isSelf(uid);
        allow update, delete: if false;
      }
      match /subscriptions/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
      match /payments/{id} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // --- The catalogue ----------------------------------------------------
    // Plans and prices are on the page already; there is nothing to hide.
    match /products/{id} {
      allow read: if true;
      allow write: if false;
      match /prices/{price} {
        allow read: if true;
        allow write: if false;
      }
      match /tax_rates/{rate} {
        allow read: if true;
        allow write: if false;
      }
    }

    // --- The story text ---------------------------------------------------
    // The point of the whole exercise. Nobody reads this from a browser: not
    // a stranger, not a signed-in reader, not a paying subscriber. The only
    // reader is the `story` function, which runs with admin credentials and
    // therefore does not pass through these rules at all — and which will not
    // return a paid story until it has verified an ID token and read the
    // `premium` flag below for itself.
    //
    // Written closed rather than "allow read: if premium" on purpose. A rule
    // like that would work, but it would also mean a client holding the
    // Firestore SDK could pull all 49 paid stories in one query the moment
    // it went premium, and could enumerate document ids either way. Making
    // the function the only door means the door can be watched.
    match /stories/{id} {
      allow read, write: if false;
    }

    // --- The catalogue ----------------------------------------------------
    // Covers, titles, hooks, lengths, topics and artwork credits for all 51
    // stories — and not one card of body text. SPEC.md §4: "covers are the
    // pitch", so a locked story still has to show its artwork to a signed-out
    // stranger. There is nothing here that is not already on the marketing
    // pages, which is why it is public.
    //
    // One document, so a whole library screen costs one read. Public here as
    // well as through the function so the client may take either route.
    match /catalogue/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // --- The editorial calendar -------------------------------------------
    // One document per date, id `YYYY-MM-DD`, holding `id: "44"` — the story
    // the owner wants free that day. Absent means "no opinion", and the
    // deterministic pick in functions/today.js stands.
    //
    // READ is open because the answer is open: today's free story is announced
    // on the front page the moment anybody loads it, and there is nothing in
    // here but a story id and, optionally, a note to the owner's future self.
    // A stranger reading tomorrow's row learns which public-domain painting is
    // on the front page tomorrow. Being public also means the site could read
    // it directly if the function were ever unavailable.
    //
    // WRITE is closed to every browser, without exception, and that is the
    // whole point of the feature. A client that could write here could
    // nominate any of the fifty-one stories as today's and then demand it
    // from the `story` function — which honours this collection — and be
    // handed the text for nothing. The only writers are the Firebase console
    // and anything holding admin credentials.
    match /daily/{date} {
      allow read: if true;
      allow write: if false;
    }

    // --- Seed metadata ----------------------------------------------------
    // Corpus version and counts, so a client can bust its own cache without
    // downloading the catalogue to find out whether it changed.
    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // --- The support inbox ------------------------------------------------
    // What the two boxes on /support collect. Closed to every browser in both
    // directions, and that is the design rather than an oversight.
    //
    // WRITE. The obvious rule here would be `allow create: if` a shape check,
    // and it would work — the shape helpers above are already written. It is
    // not what is deployed, because a rule cannot count. A support message
    // comes from a signed-out stranger by definition (that is who needs
    // support), so there is no uid to rate-limit on and no way to ask how many
    // documents this browser wrote in the last minute. A public create rule is
    // therefore a free, unmetered write endpoint, and the only honest cap it
    // could carry is on the size of each write, never on how many. The
    // `support` Cloud Function is the only door instead: it builds every field
    // itself, caps every length, throttles per IP and spends against a global
    // daily quota, and it runs with admin credentials so it does not pass
    // through these rules at all.
    //
    // READ. Nobody, ever. These documents are strangers' email addresses and
    // whatever they chose to tell us; the audience is two founders in the
    // Firebase console, which reads with admin credentials.
    match /support/{id} {
      allow read, write: if false;
    }
    // The counters the throttle actually decides on, and the salt they are
    // keyed with. `support_meta/quota` holds today's date, today's stored
    // count and today's mailed count — two budgets, because storing a message
    // is cheap and mailing one spends a third party's daily allowance.
    // `support_meta/salt` holds a random 32 bytes, regenerated every UTC day,
    // used to HMAC a caller's IP into the bucket id under `support_ip`.
    //
    // Deny-all matters more here than it looks. The salt is the only thing
    // making those bucket ids irreversible: IPv4 is four billion addresses,
    // so anyone who could read this document could brute-force the mapping
    // back to addresses. Nobody can, and it is gone within the day anyway.
    match /support_meta/{doc} {
      allow read, write: if false;
    }
    // One document per hashed IP per UTC day: counts, two timestamps and an
    // `expiresAt` for the TTL policy that deletes it about a day later. No
    // address, no message, no account. Written only by that function, and
    // read by nobody — a client that could read these could count how much
    // support traffic there is and, with the salt, whose.
    match /support_ip/{bucket} {
      allow read, write: if false;
    }

    // --- The admin analytics door (functions/insights.js, ANALYTICS-API.md) -
    //
    // There is deliberately NO analytics data in Firestore. Every event the
    // dashboard reads already lives in PostHog, put there by js/analytics.js;
    // writing a second copy here would cost a document write on every card a
    // reader looks at and leave two numbers for every question with no way to
    // say which was right. What is here is only what it costs to ask.
    //
    // `insights_rate/{uid}` is one counter per admin per UTC day: an hour
    // count, a day count, a timestamp and an `expiresAt` for a TTL policy.
    // Unlike `support_ip` there is nothing to hash — the caller is always an
    // authenticated admin whose uid is already a document id under
    // `customers`, so a counter keyed on it reveals nothing that document does
    // not, and there is no daily salt and no IP anywhere in it.
    //
    // Deny-all, and the reason is the same as the support counters: a client
    // that could write here could hand itself an unlimited budget, and a
    // client that could read here could tell when the owner is looking.
    // `{document=**}` below would already deny both; this is written out so
    // that a future rule for some neighbouring path cannot widen it by
    // accident, and so the collections have somewhere to be explained.
    match /insights_rate/{uid} {
      allow read, write: if false;
    }
    // Today's date, today's total request count and today's count of queries
    // that actually left Google for PostHog. The second is the number that
    // caps a bad day; see BACKEND.md §4d.
    match /insights_meta/{doc} {
      allow read, write: if false;
    }

    // --- Payments that could not be given to anybody ----------------------
    // `stripe_unattributed/{session or customer id}` is where the webhook
    // files a checkout whose `client_reference_id` was not a Firebase uid, or
    // was missing, or whose Stripe customer maps to no account. One of these
    // has already happened in production: a checkout went out carrying the
    // LOCAL browser id from js/account.js and the webhook wrote
    // `customers/fba0c2kqadg5iwjme09b8d4n`, a document no account can read,
    // with `premium: true` on it. The webhook refuses to create that row now
    // and writes here instead, with every key a human would need to join the
    // payment up by hand — the id the browser sent, the Stripe customer, the
    // email and the amount.
    //
    // Deny-all, both ways. It holds a buyer's email beside a payment and
    // nothing on the site reads it; it exists to be findable in the console
    // when somebody says "I paid and it did not unlock". `{document=**}`
    // below would already deny both; this is written out for the same reason
    // `insights_rate` is — so a future rule for a neighbouring path cannot
    // widen it by accident, and so the collection has somewhere to be
    // explained.
    match /stripe_unattributed/{id} {
      allow read, write: if false;
    }

    // --- The launch alarm (functions/alerts.js, ALERTS.md) ------------------
    //
    // `alerts/{stamp-xxxx}` is one document per alert RAISED — somebody
    // opened /firststory, somebody reached the login page, somebody created
    // an account — holding the exact subject and body that was, or would have
    // been, emailed to the owner. It is written whether or not the mail could
    // go, which is the whole point of it: RESEND_API_KEY still holds a
    // placeholder, so every alert raised today is archived and not sent, and
    // this collection is where they are recovered from when the key lands.
    //
    // Deny-all, both ways, and this one holds more than a counter. A signup
    // alert carries the new account's email address beside the moment it was
    // made — that is the one field that tells a stranger joining from one of
    // us making another test account, and it is exactly the field no browser
    // may read. Nothing on the site reads this collection; it exists to be
    // found in the console and mailed by the function that wrote it.
    //
    // No `expiresAt` and no TTL policy, unlike `support_ip` and
    // `insights_rate`. Those are counters that stop mattering after a day;
    // this is the archive, and an archive that deletes itself answers "what
    // did I miss while the mail was off" with nothing.
    match /alerts/{id} {
      allow read, write: if false;
    }
    // `alerts_meta/state` is one singleton: today's date, the two PostHog
    // watermarks, which of the three alerts have already been mailed today,
    // today's counts, and the day's spend against the PostHog and Resend
    // caps. It is the thing that stops the same arrival being reported twice
    // across a cold start or a redeploy, and the thing that stops forty
    // emails on the morning it finally works — so a client that could write
    // here could silence the alarm or make it fire on demand, and a client
    // that could read it could tell exactly when the owner last looked.
    //
    // `{document=**}` below would already deny both; this is written out for
    // the same reason `insights_rate` is — so a future rule for a
    // neighbouring path cannot widen it by accident, and so the collections
    // have somewhere to be explained.
    match /alerts_meta/{doc} {
      allow read, write: if false;
    }

    // --- The campaign's promo codes (functions/promo.js) --------------------
    // One document per minted code, id `BCDF...` — the normalised code itself,
    // which is what makes minting a create() that cannot silently overwrite a
    // live code, and validate a single get by id rather than a query.
    //
    // Deny-all, both ways, and for exactly the reason `stories/` is deny-all:
    // the only reader is a function running with admin credentials, which does
    // not pass through these rules at all. A rule like `allow read: if true`
    // would work for validation and would also let any browser holding the
    // Firestore SDK ENUMERATE the campaign — every unspent code in one query —
    // and drain a week of free trials into a for-loop. Making the function the
    // only door means the door can be watched and rate-limited.
    //
    // Write is closed for the obvious reason: a client that could write here
    // could mint itself a code, or un-spend one. Nothing on the site writes
    // these; tools/mint-promo-codes.js does, with a service-account key.
    //
    // None of this is entitlement. A promo code changes which Stripe Payment
    // Link a reader is sent to. `customers/{uid}.premium` above is written by
    // the Stripe webhook and by nothing else.
    match /promo_codes/{code} {
      allow read, write: if false;
    }

    // --- The board the two of us run on (js/admin-tasks.js, admin/tasks.html) -
    //
    // `admin_tasks/{id}` is one thing to do, optionally by a day;
    // `admin_goals/{id}` is one thing to hit, with a measure in prose and,
    // optionally, the same kind of day. Hassan and Kathryn both edit both,
    // live, from the browser — which makes these the only client-WRITTEN
    // collections on the site outside a reader's own subdocuments, and the only
    // ones where the client doing the writing is trusted with more than its own
    // row.
    //
    // ADMINS ONLY, BOTH WAYS, NO EXCEPTIONS. Not "read if signed in" — a
    // stranger with an account must get nothing, not a partial list, because
    // the board says out loud what is unfinished about the money path, which
    // Stripe keys are still test, and what we know is broken. Read is therefore
    // the same isAdmin() as write. There is no query-shaped escape hatch either:
    // a `where` clause cannot widen a rule, so a non-admin listing this
    // collection is denied outright rather than handed the documents that
    // happen to match.
    //
    // THE SHAPE IS CHECKED HERE, not in the client. js/admin-tasks.js coerces
    // every value before it sends it, and that is a convenience for whoever is
    // typing, not a boundary: the site is static, its JavaScript is public, and
    // anybody holding an admin account could open a console and write whatever
    // shape they liked. So the enums are listed again below, in full. If the
    // two lists ever disagree, this one is the one that decides.
    //
    // ONE UNLISTED KEY DENIES THE WHOLE WRITE, exactly as the onboarding rule
    // above works, and note what hasOnly() means on an UPDATE:
    // request.resource.data is the document as it will be AFTER the merge, not
    // the patch. So a field written by hand in the console, or by an older
    // version of the seeder, does not sit there harmlessly — it makes every
    // later edit from the browser fail. That is the intended direction (a
    // surprise is refused, not absorbed), and it is why tools/seed-tasks.js
    // writes these twelve keys and nothing else, keeping its idempotency key in
    // the DOCUMENT ID rather than in a thirteenth field.
    //
    // ADDING A KEY IS A MIGRATION, and `due` is the worked example. The 130-odd
    // rows already on the board have no `due`, and they must go on being
    // editable — which they do, because hasOnly() constrains the keys that ARE
    // present and dayStr() treats absent as legal. What is NOT safe is the
    // reverse order: shipping a browser that writes a key this list does not
    // name turns every subsequent edit of every touched row into
    // permission-denied, silently, with a UI that looks fine. The rules go
    // first, or in the same commit; never after.
    //
    // TIMESTAMPS COME OFF THE SERVER CLOCK. `updatedAt` must equal request.time
    // on every write, which means the client has to send serverTimestamp() and
    // cannot forge "I edited this first". On create, `createdAt` must equal
    // request.time as well; on update it must equal what is already stored, so
    // an edit cannot rewrite when a task appeared. `doneAt` is the one
    // timestamp a client may set freely-ish — timestamp or null — because the
    // seeder backdates it to the real commit date and the board has to be able
    // to show that history.
    //
    // `updatedBy` must be the writer's own uid, off their ID token. Two people
    // share this board and "who moved this" is the only thing either of them
    // can ask about a change; a field the client could put any string in would
    // answer that question wrongly and confidently.
    //
    // LABELS — the tags a task is filed under, replacing the single `area`.
    // A list, capped at 6, and here is the part that must be said plainly
    // rather than implied, in the same spirit as the note above about
    // "2026-02-31":
    //
    //     THESE RULES CANNOT CHECK THE ELEMENTS OF A LIST. There is no loop
    //     in this language and RE2 cannot be applied across a list, so
    //     `labels is list` and `size() <= 6` is the whole of what is
    //     enforced HERE. The shape of each element — lowercase, trimmed,
    //     `^[a-z0-9][a-z0-9-]{0,23}$`, no empties, no duplicates — is
    //     enforced by label() and labelList() in js/admin-tasks.js and by
    //     nothing else.
    //
    // What that means in practice, stated honestly: an admin holding a
    // console can put a 900-character string, a number, or the empty string
    // into this list, and these rules will accept it. What they cannot do is
    // put 700 of them in (the count is capped), and they cannot do it to
    // anybody else's data, because the only people who can write here at all
    // are the two people the board belongs to. The cap is a real limit; the
    // element shape is a convention this file is not able to keep. A rule
    // that pretended otherwise would be the more dangerous thing.
    //
    // `area` stays in the key list because 149 rows still carry one and they
    // must go on being editable. Nothing writes it any more: js/admin-tasks.js
    // folds an old row's area into `labels` at the first edit.
    function taskShape() {
      return request.resource.data.keys().hasOnly([
               "title", "detail", "owner", "priority", "status", "area",
               "labels", "due", "order", "createdAt", "updatedAt", "doneAt",
               "updatedBy", "createdBy", "createdByName", "doneBy", "doneByName"
             ])
        && reqStr("title", 120)
        && shortStr("detail", 600)
        && shortStr("area", 40)
        && smallList("labels", 6)
        && dayStr("due")
        && request.resource.data.owner in ["hassan", "kathryn", "either"]
        && request.resource.data.priority in ["high", "low"]
        && request.resource.data.status in ["todo", "doing", "done"]
        && request.resource.data.order is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!("doneAt" in request.resource.data)
            || request.resource.data.doneAt == null
            || request.resource.data.doneAt is timestamp)
        // WHO CLOSED IT. Written by the same patch that writes doneAt, and it
        // is either nobody (the task is not done) or the person making this
        // very request. There is no third possibility: a client that could
        // name somebody else as the closer could put Kathryn's name on work
        // she did not finish, on the one record either of them would ever
        // consult to find out.
        && (!("doneBy" in request.resource.data)
            || request.resource.data.doneBy == null
            || request.resource.data.doneBy == request.auth.uid)
        && nullStr("doneByName", 60)
        // WHO CREATED IT is checked at the two ends rather than here, because
        // the answer differs: on create it must be the requester, and on
        // update it must be exactly what is already stored — see both match
        // blocks below. Here it is only pinned to a sane size and type.
        && shortStr("createdBy", 128)
        && shortStr("createdByName", 60)
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function goalShape() {
      return request.resource.data.keys().hasOnly([
               "title", "detail", "target", "status",
               "due", "order", "createdAt", "updatedAt", "updatedBy"
             ])
        && reqStr("title", 120)
        && shortStr("detail", 600)
        && shortStr("target", 40)
        && dayStr("due")
        && request.resource.data.status in ["open", "hit", "missed"]
        && request.resource.data.order is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // --- A thread, on a task or on a goal ---------------------------------
    //
    //     admin_tasks/{id}/comments/{cid}
    //     admin_goals/{id}/comments/{cid}
    //
    // ONE FUNCTION, TWO PLACES, on purpose. A goal is the thing most worth
    // arguing about on this board and the argument belongs on the goal, so
    // both collections carry a thread — and the second copy of a validation
    // rule is the one that drifts. If the shape of a comment ever changes it
    // changes here, once, for both.
    //
    // A SUBCOLLECTION RATHER THAN AN ARRAY on the parent, and these rules are
    // half the reason: hasOnly() can pin a document's keys and this pins a
    // comment's, but nothing in this language can validate the elements of a
    // growing array (see the labels note above). One document per comment gets
    // one real validation each — length, author, clock.
    //
    // NO UPDATE, EVER. A comment is a record of something one of them said.
    // Wrong comment: delete it and say the next thing. An edit path would let
    // either of them rewrite what is on the other's screen with no trace,
    // which is the one property a shared record must not have.
    //
    // `at == request.time` forces serverTimestamp(): a browser with a wrong
    // clock cannot post a comment into the middle of yesterday. `by` is the
    // uid off the ID token and is the only identity here that is evidence;
    // `byName` is what that account called itself and is a convenience for
    // printing, which is why it is capped and otherwise unchecked.
    function commentShape() {
      return request.resource.data.keys().hasOnly(["text", "by", "byName", "at"])
        && reqStr("text", 1000)
        && shortStr("byName", 60)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }
    // DELETE IS THE AUTHOR'S, with one deliberate exception. A comment belongs
    // to whoever wrote it: on a two-person board a deletion by the other
    // person is indistinguishable from the author's own and there is no audit
    // trail to tell them apart, so the answer to "please take that down" is to
    // ask, or to delete the whole task. The exception is a comment whose
    // PARENT IS ALREADY GONE — deleteTask()/deleteGoal() sweep the thread
    // after removing the document, and without this clause that sweep would
    // stop dead at the first comment the other person wrote, leaving orphans
    // under a document that no longer exists. exists() costs a read and is
    // only ever reached on the sweep, because the author check in front of it
    // short-circuits every ordinary delete.
    function commentDeletable(parentPath) {
      return resource.data.by == request.auth.uid || !exists(parentPath);
    }

    match /admin_tasks/{id} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      // `createdBy` is OPTIONAL on create and pinned to the requester when it
      // is there. Optional rather than required for one reason: a browser
      // still running the previous version of js/admin-tasks.js out of its
      // cache does not send it, and a rule that required it would turn "Add a
      // task" into permission-denied for whichever of them had not reloaded.
      // Present-and-wrong is refused; absent is a task with no recorded
      // author, which is a thing this collection already has 149 of.
      allow create: if isAdmin()
        && taskShape()
        && request.resource.data.get("createdBy", request.auth.uid) == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // AN UPDATE MAY NEVER TOUCH THE AUTHOR — and note what the two get()s
      // with the same default buy, which is more than "do not change it":
      // absent must stay absent, so an update cannot ADD an author to one of
      // the 149 rows that has none. That is the rule that makes the detail
      // view's "not recorded" honest. Without it, the first person to edit an
      // old task could quietly become its creator, and nothing on the board
      // would ever say otherwise.
      allow update: if isAdmin()
        && taskShape()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get("createdBy", "") == resource.data.get("createdBy", "")
        && request.resource.data.get("createdByName", "") == resource.data.get("createdByName", "");

      // The thread on this task. Written once, for both collections — see
      // commentShape() and commentDeletable() above.
      match /comments/{cid} {
        allow read: if isAdmin();
        allow create: if isAdmin() && commentShape();
        allow update: if false;
        allow delete: if isAdmin()
          && commentDeletable(/databases/$(database)/documents/admin_tasks/$(id));
      }
    }

    match /admin_goals/{id} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      allow create: if isAdmin()
        && goalShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && goalShape()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt;

      // The thread on this goal. Identical to the one on a task, from the same
      // two functions — "is one paying subscriber still the right goal this
      // month" is a conversation, and it should live on the goal rather than
      // in a chat neither of them can find later.
      match /comments/{cid} {
        allow read: if isAdmin();
        allow create: if isAdmin() && commentShape();
        allow update: if false;
        allow delete: if isAdmin()
          && commentDeletable(/databases/$(database)/documents/admin_goals/$(id));
      }
    }

    // --- The reel experiments (js/admin-experiments.js, admin/experiments.html) -
    //
    //     admin_experiments/{id}                 one experiment
    //     admin_experiments/{id}/reels/{rid}     one reel posted under it
    //     admin_experiments/{id}/comments/{cid}  the thread on it
    //
    // The third client-written collection on this site, and it belongs to the
    // same two people as the board next door. ADMINS ONLY, BOTH WAYS, NO
    // EXCEPTIONS, and read is the same isAdmin() as write for the same reason
    // the task board's is: this collection says out loud which of our own
    // reels flopped and what we think is wrong with them, and a stranger with
    // an account must get nothing rather than a partial list.
    //
    // THREE STATUSES AND NOT FOUR. `status` is idea / running / ended.
    // "EXPIRED" IS NOT STORED ANYWHERE — a running experiment whose `endBy`
    // has gone past is DERIVED as expired by the page, from the stored day and
    // the reader's clock. A stored fourth state would be correct when it was
    // written and wrong at midnight, with nothing running to fix it, and the
    // first person to notice would be whoever trusted it. The clock changes
    // it, so the clock computes it.
    //
    // THE TWO INSTANTS ON A REEL ARE WHAT THE WHOLE THING IS FOR. `postedAt`
    // and `measuredAt` are stored separately rather than storing "the numbers
    // and a date" precisely so the AGE at measurement can be recovered. Every
    // reel on this board is meant to be read at 72 HOURS OLD, never on a
    // calendar date, because reels have long tails and comparing a two-day-old
    // video against a six-hour-old one measures age and not quality. The rules
    // cannot enforce that — it is a comparison between two fields and a
    // constant, and a rule that refused an early reading would simply mean the
    // reading never got typed. What the rules do is keep both instants real
    // timestamps so the page can show a too-early reading AS too early instead
    // of averaging it in.
    //
    // ONE REQUIRED FIELD PER DOCUMENT, AND THAT IS A PRODUCT DECISION MADE
    // HERE. An experiment needs a `title`; a reel needs a `story`. Everything
    // else — every metric, both instants, the URL, the cover, the variant — is
    // optional and null-able. Two people post a few reels a week: a form that
    // refuses to save until eleven boxes are full is a form that gets
    // abandoned, and a half-filled row is worth enormously more than a row
    // nobody typed. numOrNull() above is what makes "left blank" a first-class
    // value rather than a zero.
    //
    // ONE UNLISTED KEY DENIES THE WHOLE WRITE, and on an UPDATE
    // request.resource.data is the document AFTER the merge, not the patch —
    // so a field written by hand in a console does not sit there harmlessly,
    // it makes every later edit from the browser fail. Same direction as the
    // task board, same reason, and the same warning applies to adding a key:
    // the rules go first, or in the same commit, never after.
    //
    // TIMESTAMPS COME OFF THE SERVER CLOCK for `updatedAt` and `createdAt`,
    // exactly as on the task board, so a client cannot forge "I edited this
    // first". `startedAt` and `endedAt` are written by startExperiment() and
    // endExperiment() with serverTimestamp() and are checked here only for
    // type — a create sends them as null and an update may clear them, and
    // pinning them to request.time would make "restart this" impossible to
    // express.
    //
    // LISTS, AND WHAT THESE RULES CANNOT SAY ABOUT THEM. `links` is a list of
    // reference URLs and `retention` is a list of {second, percent} points
    // typed off the Insights graph. Repeating the note above taskShape()
    // because it matters twice as much here:
    //
    //     THESE RULES CANNOT CHECK THE ELEMENTS OF A LIST. There is no loop
    //     in this language, so `links is list` and `size() <= 8` is the whole
    //     of what is enforced HERE — the https:// scheme of each element is
    //     enforced by safeUrl() in js/admin-experiments.js and by nothing
    //     else. Likewise `retention is list` and `size() <= 40`; that each
    //     element is {s: number, p: number} is retentionList()'s promise.
    //
    // What that means in practice: an admin holding a console can put a
    // 900-character string in `links` and these rules will accept it. What
    // they cannot do is put 700 of them in, and they cannot do it to anybody
    // else'"'"'s data, because the only people who can write here are the two
    // people the board belongs to. The cap is a real limit; the element shape
    // is a convention this file is not able to keep, and a rule that pretended
    // otherwise would be the more dangerous thing.
    //
    // `source` IS WRITTEN TODAY FOR A PATH THAT DOES NOT EXIST YET. Every
    // number on this board is typed off a phone screen by hand, so every reel
    // is written with source "manual". The enum already names "instagram" and
    // "tiktok" so that the day a fetch lands it writes into the same
    // collection with the same shape and no migration — and so a chart can
    // one day tell a typed number from a fetched one rather than assuming
    // they are the same kind of thing.
    function expShape() {
      return request.resource.data.keys().hasOnly([
               "title", "detail", "status", "hypothesis", "trying", "metric",
               "decision", "inspiration", "links", "endBy",
               "startedAt", "endedAt", "outcome",
               "analysis", "analysisBy", "analysisByName", "analysisAt",
               "analysisRequestedAt",
               "order", "createdAt", "updatedAt", "updatedBy",
               "createdBy", "createdByName"
             ])
        && reqStr("title", 120)
        && shortStr("detail", 240)
        && shortStr("hypothesis", 600)
        && shortStr("trying", 600)
        && shortStr("decision", 600)
        && shortStr("inspiration", 600)
        && shortStr("outcome", 600)
        && smallList("links", 8)
        && dayStr("endBy")
        && request.resource.data.status in ["idea", "running", "ended"]
        // THE PRIMARY METRIC is one of the ten a reel can carry and nothing
        // else. Listed again here rather than trusted from the client for the
        // reason the whole file gives: the site is static, its JavaScript is
        // public, and this list is the one that decides.
        && request.resource.data.metric in [
             "views", "reach", "likes", "comments", "shares", "saves",
             "profileTaps", "avgWatch", "completion", "threeSec"
           ]
        && tsOrNull("startedAt")
        && tsOrNull("endedAt")
        && request.resource.data.order is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && analysisShape()
        && shortStr("createdBy", 128)
        && shortStr("createdByName", 60)
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // --- THE WRITTEN READ, and why its author is pinned ---------------------
    //
    // `analysis` is a paragraph saying what a result MEANS and what to try
    // next. It is the one field on this board that is an OPINION rather than a
    // measurement — everything the page says about hooks, drop-off points and
    // whether an A/B gap clears the noise is arithmetic computed in the
    // browser on every paint and stored nowhere at all, because a number that
    // can be recomputed needs no author and cannot go stale.
    //
    // This one has an author, and the author is pinned to the uid on the
    // request'"'"'s own ID token — exactly like `doneBy` on a task, and for a
    // sharper version of the same reason. A client that could name somebody
    // else as the writer could put Kathryn'"'"'s name on a read she never wrote,
    // on the one record either of them would consult to find out what we
    // decided and why. `analysisByName` beside it is what that account called
    // itself and is a convenience for printing, never evidence.
    //
    // THE LIMIT, STATED RATHER THAN IMPLIED: `analysisAt` is checked for TYPE
    // and not pinned to request.time, the same freedom `doneAt` has. Pinning
    // it would mean an update that touches nothing else — renaming the
    // experiment — would have to re-stamp a read it is not changing, because
    // on an update request.resource.data is the document after the merge and
    // the stored value is what would be compared. So an admin holding a
    // console can date a read wrongly. They cannot sign it as the other
    // person, which is the half that matters, and there are exactly two people
    // who can write here at all.
    //
    // `analysisRequestedAt` IS A FLAG FOR A JOB THAT DOES NOT EXIST. It is
    // where "somebody asked for a read to be written" would be recorded so a
    // Cloud Function could notice. NOTHING WATCHES IT. It is here because the
    // seam is worth having and the page says in those words that no job is
    // coming, rather than showing a spinner for something that is not.
    //
    // Nothing in the browser calls a model and no key for one may ever be
    // added to this repo: it is public, and a key in client JavaScript is a
    // key in the world. A future writer of these fields runs server-side with
    // a service-account credential and does not pass through these rules at
    // all — which is precisely why the shape is validated here for the client
    // that does.
    function analysisShape() {
      return shortStr("analysis", 1200)
        && nullStr("analysisByName", 60)
        && tsOrNull("analysisAt")
        && tsOrNull("analysisRequestedAt")
        && (!("analysisBy" in request.resource.data)
            || request.resource.data.analysisBy == null
            || request.resource.data.analysisBy == request.auth.uid);
    }

    // --- One reel, under one experiment ------------------------------------
    // `story` is the only thing it cannot exist without. Ten metrics, both
    // instants, the URL, the cover and the variant are every one of them
    // optional — see the note above expShape() for why that is the decision
    // the board lives or dies on.
    function reelShape() {
      return request.resource.data.keys().hasOnly([
               "story", "url", "platform", "variant", "format",
               "postedAt", "cover", "coverPath",
               "views", "reach", "likes", "comments", "shares", "saves",
               "profileTaps", "avgWatch", "completion", "threeSec",
               "measuredAt", "retention", "source",
               "analysis", "analysisBy", "analysisByName", "analysisAt",
               "order", "createdAt", "updatedAt", "updatedBy"
             ])
        && reqStr("story", 120)
        && httpsStr("url", 500)
        // THE COVER IS A URL AND NEVER BYTES. A Firestore document is capped
        // at 1MB and is pushed to every open listener on every change, so a
        // base64 image would blow the cap on the second reel and re-send the
        // picture to both browsers every time somebody typed a number. The
        // file lives in Cloud Storage under admin/experiments/{id}/ — see
        // storage.rules — or it is a URL somebody pasted. Either way what is
        // stored here is a string, and httpsStr() is what stops that string
        // being `javascript:`.
        && httpsStr("cover", 1000)
        && shortStr("coverPath", 300)
        && shortStr("format", 24)
        && request.resource.data.platform in ["instagram", "tiktok", "other"]
        && request.resource.data.variant in ["a", "b", "none"]
        // WHERE THE NUMBER CAME FROM. "manual" is the only value anything
        // writes today, because every figure on this board is typed off a
        // phone screen by a person. "api" is listed so that a writer which is
        // not a person needs no rules change to say so, and the two platform
        // names are listed for when that distinction matters. NOTHING FETCHES
        // ANYTHING. Note also the deadline this field exists under: TikTok
        // stops serving reach, watch time and retention for a video with no
        // activity for seven days, and Instagram has never exposed a retention
        // curve at all — so an unlogged reel is not a gap that can be filled
        // in later, it is data that is gone. That is a UI problem, not a rules
        // problem, and the page is where it is handled.
        && request.resource.data.source in ["manual", "api", "instagram", "tiktok"]
        && tsOrNull("postedAt")
        && tsOrNull("measuredAt")
        && smallList("retention", 40)
        // The ten numbers. Counts get a ceiling that no reel either of them
        // posts will ever reach and that a pasted phone number does; seconds
        // get a day; the two percentages get 100, because a completion rate of
        // 340% is a typo and charting it would make every other bar unreadable.
        && numOrNull("views", 0, 10000000000)
        && numOrNull("reach", 0, 10000000000)
        && numOrNull("likes", 0, 10000000000)
        && numOrNull("comments", 0, 10000000000)
        && numOrNull("shares", 0, 10000000000)
        && numOrNull("saves", 0, 10000000000)
        && numOrNull("profileTaps", 0, 10000000000)
        && numOrNull("avgWatch", 0, 86400)
        && numOrNull("completion", 0, 100)
        && numOrNull("threeSec", 0, 100)
        && analysisShape()
        && request.resource.data.order is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /admin_experiments/{id} {
      allow read: if isAdmin();
      allow delete: if isAdmin();
      // `createdBy` is OPTIONAL on create and pinned to the requester when it
      // is there — the same shape as a task, for the same reason: a browser
      // running a cached older copy of js/admin-experiments.js must not have
      // "Add an experiment" turn into permission-denied.
      allow create: if isAdmin()
        && expShape()
        && request.resource.data.get("createdBy", request.auth.uid) == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // AN UPDATE MAY NEVER TOUCH THE AUTHOR, and the two get()s with the same
      // default buy more than "do not change it": absent must stay absent, so
      // an update cannot ADD an author to a row that has none.
      allow update: if isAdmin()
        && expShape()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get("createdBy", "") == resource.data.get("createdBy", "")
        && request.resource.data.get("createdByName", "") == resource.data.get("createdByName", "");

      // The reels posted under this experiment. A SUBCOLLECTION AND NOT AN
      // ARRAY on the experiment, for the reasons js/admin-experiments.js sets
      // out — the decisive one being that the conflict rule on this site is a
      // field-level merge, so an array of reels is ONE field and Kathryn
      // typing reel B'"'"'s numbers while Hassan types reel A'"'"'s would lose a
      // minute of somebody'"'"'s typing with nothing on screen to say so. Two
      // documents cannot collide. The second reason is this rule: hasOnly()
      // can pin a document'"'"'s keys and can say nothing at all about the
      // elements of a growing array, and a reel carries ten numbers and two
      // instants that are worth validating at the boundary.
      //
      // NO UPDATE RESTRICTION ON WHO MAY EDIT A REEL, unlike a comment. A reel
      // is a shared record of a post, not a remark somebody made: either of
      // them may fix a number the other typed wrong, because the alternative
      // is a board where a typo is permanent unless its author happens to be
      // awake.
      match /reels/{rid} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && reelShape()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isAdmin()
          && reelShape()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt;
        // Either admin may delete a reel, and a reel whose experiment is
        // already gone may be deleted by either of them too — deleteExperiment()
        // sweeps both subcollections after removing the parent, and Firestore
        // does not cascade. Without the exists() clause that sweep would leave
        // whatever the other person created orphaned under a document that no
        // longer exists: invisible, unreachable, and still on the bill.
        allow delete: if isAdmin();
      }

      // The thread on this experiment. commentShape() and commentDeletable()
      // are the SAME two functions the task board and the goal board use —
      // written once for all three, because the second copy of a validation
      // rule is the one that drifts. "Do we call this one yet" is a
      // conversation and it belongs on the experiment.
      match /comments/{cid} {
        allow read: if isAdmin();
        allow create: if isAdmin() && commentShape();
        allow update: if false;
        allow delete: if isAdmin()
          && commentDeletable(/databases/$(database)/documents/admin_experiments/$(id));
      }
    }

    // --- Everything else --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
